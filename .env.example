# ==========================================
# Study Pilot Environment Configuration
# ==========================================
# Copy this file to .env or .env.local to customize local settings.
# Sensitive cookies and credentials are NEVER stored in this file.

# Backend API Configuration
DATABASE_URL=sqlite:///data/studypilot.db
DEFAULT_SYNC_INTERVAL_HOURS=24
LOG_LEVEL=INFO

# Frontend Client Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Moodle Instance (configurable via UI Settings or here)
# Default for Salim Habib University: https://lms.shu.edu.pk
MOODLE_BASE_URL=https://lms.shu.edu.pk
